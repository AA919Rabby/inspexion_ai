PROJECT_NAME="InspeXion AI"
API_V1_STR="/api/v1"
SECRET_KEY="generate_a_secure_random_string_here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Neon Database Connection URL (postgresql+asyncpg://...)
DATABASE_URL="enter_your_neon_tech_database_url_here"

# Google OAuth Client ID (Web Client ID)
GOOGLE_CLIENT_ID="enter_google_client_id_here"

# OpenRouter AI Credentials
OPENROUTER_API_KEY="enter_your_openrouter_api_key_here"
OPENROUTER_MODEL="enter_open_router_model"

# Cloudinary Storage Credentials
CLOUDINARY_CLOUD_NAME="enter_your_cloudinary_cloud_name_here"
CLOUDINARY_API_KEY="enter_your_cloudinary_api_key_here"
CLOUDINARY_API_SECRET="enter_your_cloudinary_api_secret_here"